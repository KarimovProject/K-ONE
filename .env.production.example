# Django production (copy outside Git-managed deployment files and replace every placeholder)
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=iems.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://iems.example.org
DJANGO_LANGUAGE_CODE=uz
DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_STATIC_ROOT=/srv/iems/staticfiles
DJANGO_MEDIA_ROOT=/srv/iems/media
IEMS_BASE_URL=https://iems.example.org
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# HTTPS policy. Enable preload only after the domain and all subdomains are permanently ready.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# PostgreSQL
DB_NAME=iems
DB_USER=iems_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Email remains fail-closed unless a production backend and credentials are configured.
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Personal Telegram reminders, optional and disabled by default.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Telegram Channel publishing, optional and not live-tested.
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_CHAT_ID=

# Official Meta/Instagram Graph API, optional and not live-tested.
INSTAGRAM_ENABLED=false
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
