# Native Windows development (copy to .env and replace placeholders)
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LANGUAGE_CODE=uz
DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_STATIC_ROOT=C:/IEMS/staticfiles
DJANGO_MEDIA_ROOT=C:/IEMS/media

# Native PostgreSQL Windows service
DB_NAME=iems
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Native Redis Windows service
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=false

# Personal staff Telegram reminders (disabled until explicitly configured)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
IEMS_BASE_URL=http://127.0.0.1:8000
